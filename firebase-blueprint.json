        "step_type": {
          "type": "string",
          "enum": [
            "VOICE_INTENT",
            "TOOL_CALL",
            "POLICY_CHECK",
            "HITL_PAUSE",
            "EXECUTED",
            "UNDO",
            "RESTOCK",
            "ERROR"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        },
        "latency_ms": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "session_id",
        "step_type",
        "title",
        "detail",
        "latency_ms",
        "createdAt"
      ]
