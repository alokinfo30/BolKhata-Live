  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer Khata ledger accounts owned by the authenticated shopkeeper."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Wholesale inventory SKUs and stock counts owned by the authenticated shopkeeper."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Immutable-by-default transaction ledger with undo rollback snapshots."
    },
    "/approvals/{approvalId}": {
      "schema": { "$ref": "#/entities/Approval" },
      "description": "HITL Manager approval requests for credit breaches and high-value orders."
    },
    "/restocks/{restockId}": {
      "schema": { "$ref": "#/entities/RestockOrder" },
      "description": "Automated distributor purchase orders."
    },
    "/sentiment_logs/{logId}": {
      "schema": { "$ref": "#/entities/SentimentLog" },
      "description": "Real-time user feedback and sentiment entries."
    },
    "/agent_traces/{traceId}": {
      "schema": { "$ref": "#/entities/AgentTrace" },
      "description": "Real-time agent workflow execution traces and latency records."
    },
    "/voice_transcripts/{transcriptId}": {
      "schema": { "$ref": "#/entities/VoiceTranscript" },
      "description": "Persisted timestamped voice counter conversation transcripts."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Digital Parchi receipts issued to stores and traders."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/StoreNotification" },
      "description": "Audit log of receipt and Khata notifications dispatched to each store or trader."
    },
    "/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/DeliveryRecord" },
      "description": "Order dispatch and pending/delivered tracking records owned by the shopkeeper."
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/CustomerComplaint" },
      "description": "Registered customer and trader service complaint tickets owned by the shopkeeper."
    }
  }
}
