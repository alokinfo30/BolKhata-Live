{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Wholesale/kirana customer account with Udhaar credit balance and limit.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the shop owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer store or trader name."
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30,
          "description": "Contact phone number (PII)."
        },
        "location": {
          "type": "string",
          "maxLength": 120,
          "description": "Market or area name."
        },
        "current_udhaar_balance": {
          "type": "number",
          "description": "Current outstanding credit balance in INR."
        },
        "credit_limit": {
          "type": "number",
          "description": "Maximum allowed credit limit in INR."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "phone",
        "location",
        "current_udhaar_balance",
        "credit_limit",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Wholesale stock item with regional aliases, unit price, and reorder threshold.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "aliases": {
          "type": "array",
          "description": "Hinglish/regional search aliases (max 10)."
        },
        "stock_qty": {
          "type": "number"
        },
        "unit_price": {
          "type": "number"
        },
        "reorder_threshold": {
          "type": "number"
        },
        "supplier_name": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "sku",
        "name",
        "unit",
        "aliases",
        "stock_qty",
        "unit_price",
        "reorder_threshold",
        "supplier_name",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Ledger and inventory transaction with snapshot for one-command voice undo.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tx_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customer_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customer_name": {
          "type": "string",
          "maxLength": 120
        },
        "item_sku": {
          "type": "string",
          "maxLength": 64
        },
        "item_name": {
          "type": "string",
          "maxLength": 140
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "qty": {
          "type": "number"
        },
        "unit_price": {
          "type": "number"
        },
        "total_amount": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["UDHAAR", "JAMA", "CASH_SALE"]
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "UNDONE", "PENDING_APPROVAL"]
        },
        "previous_balance": {
          "type": "number"
        },
        "previous_stock": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "tx_id",
        "customer_id",
        "customer_name",
        "item_sku",
        "item_name",
        "unit",
        "qty",
        "unit_price",
        "total_amount",
        "type",
        "status",
        "previous_balance",
        "previous_stock",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
