          "type": "string",
          "maxLength": 120
        },
        "item_sku": {
          "type": "string",
          "maxLength": 64
        },
        "item_name": {
          "type": "string",
          "maxLength": 140
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "qty": {
          "type": "number"
